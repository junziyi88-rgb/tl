{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "gongjian-tarot-d2geleaahb9b8605e",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "tarot-ai",
      "type": "HTTP",
      "protocolType": "HTTP",
      "entry": "server.js",
      "public": true,
      "gatewayPath": "/api/tarot-ai",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": false
    }
  ],
  "database": {
    "type": "postgresql",
    "migrations": "./cloudbase/migrations"
  },
  "hosting": [
    {
      "name": "web",
      "root": ".",
      "framework": "vite",
      "outputDir": "dist",
      "deployPath": "/"
    }
  ]
}
