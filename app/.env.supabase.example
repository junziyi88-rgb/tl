# Browser-safe Alibaba Supabase project settings.
VITE_SUPABASE_URL=https://your-project-supabase-endpoint.example.com
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Intentionally public, low-balance DeepSeek key embedded in the browser bundle.
VITE_DEEPSEEK_API_KEY=sk-your-disposable-low-balance-key

# Secret PostgreSQL connection string. Never expose it in browser code.
SUPABASE_DB_URL=postgresql://postgres:replace-me@your-db-host:5432/postgres?sslmode=require
